{
  "_version": "1.65.0",
  "sap.app": {
    "id": "com.capm.userattrs",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "1.0.1" },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/user-inspect/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true,
    "deviceTypes": { "desktop": true, "tablet": true, "phone": false }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "analytical"
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core":      {},
        "sap.fe.templates": {},
        "sap.m":            {},
        "sap.f":            {}
      }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "rootView": {
      "viewName": "sap.fe.core.rootView.NavContainer",
      "type": "XML",
      "async": true,
      "id": "appRootView"
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "com.capm.userattrs.i18n.i18n" }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "groupId": "$auto"
        }
      }
    },
    "routing": {
      "config": { "routerClass": "sap.m.routing.Router" },
      "routes": [
        {
          "name": "UserAttributesList",
          "target": "UserAttributesListTarget",
          "pattern": ":?query:"
        }
      ],
      "targets": {
        "UserAttributesListTarget": {
          "type": "Component",
          "id": "UserAttributesListTarget",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/UserAttributes",
              "initialLoad": "Enabled",
              "hideFilterBar": true
            }
          }
        }
      }
    }
  }
}
