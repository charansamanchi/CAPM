{
  "xsappname": "CAPM",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.User",
      "description": "Authenticated user scope"
    }
  ],
  "attributes": [
    {
      "name": "ANID",
      "description": "Ariba Network ID from SAML assertion",
      "valueType": "string"
    },
    {
      "name": "email",
      "description": "Contact email from SAML assertion",
      "valueType": "string"
    },
    {
      "name": "Permissions",
      "description": "AN permissions from SAML assertion",
      "valueType": "string"
    }
  ],
  "role-templates": [
    {
      "name": "User",
      "description": "Authenticated users",
      "scope-references": [
        "$XSAPPNAME.User",
        "user_attributes"
      ],
      "attribute-references": [
        "ANID",
        "email",
        "Permissions"
      ]
    }
  ],
  "role-collections": [
    {
      "name": "CAPM_User",
      "description": "Standard authenticated users",
      "role-template-references": [
        "$XSAPPNAME.User"
      ]
    }
  ],
  "oauth2-configuration": {
    "includeSystemAttributeGroups": true,
    "includeSystemAttributeRoleCollections": true,
    "credentialTypes": ["binding-secret", "x509"],
    "system-attributes": ["xs.saml.groups", "xs.rolecollections"]
  },
  "authorities-inheritance": false
}
